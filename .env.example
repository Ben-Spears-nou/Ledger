# Copy to .env and adjust. Never commit the real .env.
# Unset LEDGER_DB_URL to use %LOCALAPPDATA%\ledger\ledger.db (not a UNC share).
# LEDGER_DATA_DIR=C:\Users\ben.spears\AppData\Local\ledger
# LEDGER_DB_URL=sqlite:///C:/Users/ben.spears/AppData/Local/ledger/ledger.db
# For production Postgres later, e.g.:
# LEDGER_DB_URL=postgresql+psycopg://user:pass@localhost:5432/ledger

# Local API: python tasks.py run → http://127.0.0.1:8000  (/docs)
# Local UI:  cd web && npm install && npm run dev → http://127.0.0.1:5173
# Shared UI: python tasks.py build-ui, then teammates use http://<host>:8000
# Default bind is this computer only. Opt-in LAN: LEDGER_API_HOST=0.0.0.0
# (refused while LEDGER_SECRET_KEY is still the shipped default).

LEDGER_API_HOST=127.0.0.1
LEDGER_API_PORT=8000
LEDGER_LOG_LEVEL=INFO

# HMAC secret for login tokens. Change this before LEDGER_API_HOST=0.0.0.0.
LEDGER_SECRET_KEY=dev-only-change-me

# Created on first db-init when no users exist.
LEDGER_BOOTSTRAP_ADMIN_USERNAME=ben
LEDGER_BOOTSTRAP_ADMIN_PASSWORD=changeme
LEDGER_BOOTSTRAP_ADMIN_NAME=Ben
